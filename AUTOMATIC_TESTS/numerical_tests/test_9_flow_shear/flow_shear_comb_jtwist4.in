&geometry_options
    geometry_option = 'miller'
    q_as_x = .false.
/

&geometry_miller
    qinp = 1.4
    rhoc = 0.5
    rmaj = 2.77778
    rgeo = 2.77778
    shat = 0.4
    kappa = 1.0
    nzed_local = 128
/

&gyrokinetic_terms
    simulation_domain = 'fluxtube'
    include_parallel_streaming = .true.
    include_mirror = .true.
    include_xdrift = .true.
    include_ydrift = .true.
    include_drive = .true.
    include_nonlinear = .false.
    include_parallel_nonlinearity = .false.
    include_radial_variation = .false.
    include_electromagnetic = .true.
/

&electromagnetic
    beta = 0.001
    include_apar = .true.
    include_bpar = .false.
/

&species_options
    nspec = 2
    species_option = 'stella'
/

&species_parameters_1
    z = 1.0
    mass = 1.0
    dens = 1.0
    temp = 1.0
    fprim = 0.8
    tprim = 3.6
    type = 'ion'
/

&species_parameters_2
    z = -1.0
    mass = 0.00027
    dens = 1.0
    temp = 1.0
    fprim = 0.8
    tprim = 3.6
    type = 'electron'
/

&kxky_grid_option
    grid_option = 'box'
/

&kxky_grid_box
    nx = 12
    ny = 12
    y0 = 10.0
    jtwist = 4
/

&z_grid
    nzed = 12
    nperiod = 1
    ntubes = 1
/

&z_boundary_condition
    boundary_option = 'linked'
/

&velocity_grids
    nvgrid = 8
    nmu = 4
    vpa_max = 3.0
    vperp_max = 3.0
/

&initialise_distribution
    initialise_distribution_option = 'maxwellian'
    phiinit = 1.0
    scale_to_phiinit = .false.
/

&initialise_distribution_noise
    rng_seed = 7102026
/

&time_trace_options
    nstep = 160
    tend = -1.0
    autostop = .false.
/

&time_step
    delt = 0.002
    delt_max = 0.002
    delt_option = 'set_by_hand'
/

&numerical_algorithms
    explicit_algorithm = 'rk4'
    fully_explicit = .true.
    flip_flop = .false.
    stream_implicit = .false.
    mirror_implicit = .true.
    drifts_implicit = .false.
    driftkinetic_implicit = .false.
/

&numerical_upwinding_for_derivatives
    time_upwind = 0.0
    zed_upwind = 0.0
    vpa_upwind = 0.0
/

&flow_shear
    flow_shear_moving_k = .false.
    flow_shear_explicit_remap = .true.
    prp_shear_enabled = .true.
    g_exb = 0.0
    g_exbfac = 1.0
    hammett_flow_shear = .true.
    omprimfac = 0.0
    explicit_junction_sync = 'stage'
/

&dissipation_and_collisions_options
    include_collisions = .false.
    hyper_dissipation = .false.
/

&hyper_dissipation
    hyp_zed = .false.
    hyp_vpa = .false.
/

&sources
    source_option = 'none'
/

&diagnostics
    nwrite = 10
    navg = 1
    nsave = 1
    nc_mult = 1
    save_for_restart = .true.
    write_all_time_traces = .true.
/

&initialise_distribution_maxwellian
    den0 = 1.0
    upar0 = 0.0
    width0 = 0.8
/

&debug_flags
    print_extra_info_to_terminal = .false.
/

&diagnostics_potential
    write_phi_vs_kxkyz = .true.
/

&restart_options
    restart_dir = 'restart'
    save_many = .true.
/
